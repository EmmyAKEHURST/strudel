setcpm(30)


//@title Death of a tombstone - @by TombeauLatent

//waw
$: note("<[c4,e4,g4,b4] [a3,c4,e4,g4] [f3,a3,c4,e4] [g3,b3,d4,fs4]>")
  .sound("sine")
  .attack(1)
  .release(.2)
  .decay(.8)
  .sustain(.7)
  .room(1)
  .chorus(.5)
  .pan(sine.range(.3, .7).slow(8))
  .slow(2)
  .postgain(0.5)

